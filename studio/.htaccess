# The Studio: HTTPS only, no listings, and only index.php, api.php and assets/ reachable from a browser.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^(lib|vendor|tools)(/|$) - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

<FilesMatch "\.(md|json|lock|dist|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
